#usda 1.0
(
    defaultPrim = "GridPlane"
    upAxis = "Z"
    metersPerUnit = 1.0
)

def Xform "GridPlane"
{
    def Scope "Looks"
    {
        def Material "GridMaterial"
        {
            token outputs:surface.connect = </GridPlane/Looks/GridMaterial/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </GridPlane/Looks/GridMaterial/Texture.outputs:rgb>
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/workspace/src/assets/dinowm_grid/grid_texture.png@
                float2 inputs:st.connect = </GridPlane/Looks/GridMaterial/Reader.outputs:result>
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

    def Mesh "Mesh"
    {
        point3f[] points = [(-0.2, -0.2, 0), (0.2, -0.2, 0), (0.2, 0.2, 0), (-0.2, 0.2, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 1), (1, 1), (1, 0), (0, 0)] (interpolation = "vertex")
        rel material:binding = </GridPlane/Looks/GridMaterial>
    }
}
